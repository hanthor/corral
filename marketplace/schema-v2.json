{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corral.tuna-os.org/schemas/marketplace-v2.json",
  "type": "object",
  "required": ["schemaVersion", "name", "publisher", "plugins"],
  "properties": {
    "schemaVersion": {"const": "corral.marketplace/v2"},
    "name": {"type": "string", "minLength": 1},
    "publisher": {"$ref": "#/$defs/publisher"},
    "plugins": {"type": "array", "items": {"$ref": "#/$defs/plugin"}}
  },
  "additionalProperties": false,
  "$defs": {
    "publisher": {
      "type": "object", "required": ["name"],
      "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "publicKey": {"type": "string"}},
      "additionalProperties": false
    },
    "build": {
      "type": "object", "required": ["url", "sha256"],
      "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "signature": {"type": "string"}},
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "required": ["name", "description", "version", "license", "pluginApi", "publisher", "platforms"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "description": {"type": "string"}, "version": {"type": "string"}, "homepage": {"type": "string", "format": "uri"},
        "license": {"type": "string"}, "pluginApi": {"const": "corral.plugin/v1"}, "corral": {"type": "string"},
        "publisher": {"$ref": "#/$defs/publisher"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "supportedBackends": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["qemu", "kubevirt", "incus", "libvirt", "all"]}
        },
        "platforms": {"type": "object", "additionalProperties": {"$ref": "#/$defs/build"}}
      },
      "additionalProperties": false
    }
  }
}
